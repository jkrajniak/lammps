# Test script for AdResS pair_style adress with force interpolation
# This tests the new pair_style syntax with atomistic and CG sub-styles

units           lj
atom_style      atomic
dimension       3
boundary        p p p

# Create a simple box
region          box block 0 20 0 10 0 10
create_box      1 box

# Create a simple lattice of atoms
lattice         fcc 0.8442
region          atoms block 0 20 0 10 0 10
create_atoms    1 region atoms

# Define AdResS regions along x-axis
region          atomistic block 15 20 0 10 0 10
region          transition block 10 15 0 10 0 10
region          cg block 0 10 0 10 0 10

# Mass
mass            1 1.0

# AdResS pair style with two sub-styles
# Atomistic: lj/cut with cutoff 2.5, epsilon=1.0, sigma=1.0
# CG: lj/cut with cutoff 2.5, epsilon=0.5, sigma=2.0 (softer, longer range)
pair_style      adress 5.0 lj/cut 2.5 lj/cut 2.5
pair_coeff      * * 1.0 1.0 2.5 fix adres_region

# AdResS fixes
fix             1 all adress/region atomistic transition cg x
fix             2 all adress/thermo transition 2.0 fix 1

# Integration
velocity        all create 1.0 87287
fix             3 all nve

# Output
compute         1 all adress/stats 1
thermo_style    custom step temp pe ke c_1[1] c_1[2] c_1[3]
thermo          10

# Run a short test
timestep        0.005
run             50

# Print final status
print "AdResS pair_style test completed successfully!"
print "Atomistic region atoms: $(c_1[1])"
print "Transition region atoms: $(c_1[2])"
print "CG region atoms: $(c_1[3])"
print ""
print "If you see this message, the pair_style adress with force interpolation is working!"

