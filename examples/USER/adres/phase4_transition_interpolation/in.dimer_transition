# LAMMPS input script for Phase 4 Transition Region Interpolation Simple Test
# Tests position interpolation for a dimer molecule in the transition region
# Verifies:
# 1. Position interpolation formula: x_atom = λ_i · x_free + (1-λ_i) · x_constrained
# 2. Molecule stays in transition region (lambda between 0.1 and 0.9)
# 3. Interpolation is mathematically correct within 1e-6 precision
#
# System: 1 dimer (2 atoms + 1 CG particle) positioned in transition region
# Atom types: 1 = atomistic atom, 2 = CG particle
# Molecule ID: 1
# Initial position: x=6.25 (lambda ≈ 0.25)

# ============================================================================
# Initialization
# ============================================================================

units           lj
atom_style      molecular
dimension       3
boundary        p p p

# ============================================================================
# Read system configuration
# ============================================================================

read_data       data.dimer_transition

# Masses
mass            1 1.0   # Atomistic atoms
mass            2 2.0   # CG particles (mass = sum of 2 atoms)

# ============================================================================
# AdResS region definitions
# ============================================================================
# Define regions along x-axis with periodic wrapping:
# Layout: CG → Transition → Atomistic → Transition → CG (wrapping)
# CG region: 0.0-5.0 and 15.0-20.0 (edges, wraps around)
# Transition region: 5.0-7.5 and 12.5-15.0 (adjacent to CG, wraps around)
# Atomistic region: 7.5-12.5 (center)
# Molecule starts at x=6.25 (transition region, lambda ≈ 0.25)

# CG regions (left and right edges, wrapping around)
region          cg1 block 0.0 5.0 0.0 20.0 0.0 20.0
region          cg2 block 15.0 20.0 0.0 20.0 0.0 20.0
region          cg union 2 cg1 cg2

# Transition regions (adjacent to CG regions on both sides)
region          transition1 block 5.0 7.5 0.0 20.0 0.0 20.0
region          transition2 block 12.5 15.0 0.0 20.0 0.0 20.0
region          transition union 2 transition1 transition2

# Atomistic region (center, between transition regions)
region          atomistic block 7.5 12.5 0.0 20.0 0.0 20.0

# ============================================================================
# Pair interactions
# ============================================================================

# Simple LJ potential for both atomistic and CG
# Cutoff: 3.0
variable        cutoff equal 3.0

# AdResS pair style
pair_style      adress ${cutoff} lj/cut ${cutoff} lj/cut ${cutoff}

# Pair coefficients
# Atomistic: epsilon=1.0, sigma=1.0
# CG: epsilon=2.0, sigma=1.5 (stronger, larger)
pair_coeff      * * atomistic 1.0 1.0 ${cutoff} cg 2.0 1.5 ${cutoff} fix 1

# ============================================================================
# Neighbor settings
# ============================================================================

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# ============================================================================
# AdResS fixes
# ============================================================================

# Region management: calculate lambda values
fix             1 all adress/region atomistic transition cg x

# COM tracking and constraints (handles all three regions: CG, transition, atomistic)
# Syntax: fix ID group-ID adress/constraint fix-region-ID cg-type
# Lambda thresholds: CG < 0.1, Transition: 0.1 <= lambda < 0.9, Atomistic >= 0.9
fix             2 all adress/constraint 1 2 lambda_cg 0.1 lambda_at 0.9

# ============================================================================
# Integration
# ============================================================================

timestep        0.005

# Velocity initialization - low velocity to keep molecule in transition region
# Small x-component to allow some movement but stay in transition region
velocity        all set 0.5 0.0 0.0

# NVE integration
fix             3 all nve

# ============================================================================
# Output
# ============================================================================

# Compute for statistics
compute         adress_stats all adress/stats 1

# Thermo output
thermo_style    custom step temp pe ke etotal c_adress_stats[1] c_adress_stats[2] c_adress_stats[3]
thermo          10

# Dump trajectory (include velocities for verification)
dump            1 all custom 10 dimer_transition.dump id type mol x y z vx vy vz

# ============================================================================
# Run
# ============================================================================

# Run for 100 steps (short test to verify interpolation)
run             100

# ============================================================================
# Verification
# ============================================================================
# Automated verification:
#   python3 verify_interpolation.py
#
# Manual verification:
#   - Check dimer_transition.dump: molecule should stay in transition region
#   - Verify position interpolation formula: x_atom = λ_i · x_free + (1-λ_i) · x_constrained
#   - Check lambda values are between 0.1 and 0.9
#   - Verify interpolation is mathematically correct within 1e-6 precision

print "=========================================="
print "Phase 4 Transition Region Interpolation Simple Test"
print "=========================================="
print "Total atoms: $(atoms)"
print "Atomistic region atoms: $(c_adress_stats[1])"
print "Transition region atoms: $(c_adress_stats[2])"
print "CG region atoms: $(c_adress_stats[3])"
print ""
print "Verification:"
print "  1. Check that molecule stays in transition region"
print "  2. Verify position interpolation formula: x_atom = λ_i · x_free + (1-λ_i) · x_constrained"
print "  3. Check lambda values are between 0.1 and 0.9"
print "  4. Verify interpolation is mathematically correct within 1e-6 precision"
print ""
print "Automated verification:"
print "  python3 verify_interpolation.py"
print ""
print "Manual verification:"
print "  - Check dimer_transition.dump for transition region behavior"
print "  - Verify interpolation formula matches manual calculations"
print "=========================================="
