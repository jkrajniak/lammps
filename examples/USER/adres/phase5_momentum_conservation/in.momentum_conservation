# LAMMPS input script for Phase 5 Momentum Conservation Verification Test
# Tests momentum conservation in transition region where symmetric pair-weighting is critical
# Verifies:
# 1. Total momentum is conserved: P(t) = P(0) (within numerical precision)
# 2. Forces are symmetric: F_ij = -F_ji for all pairs
# 3. Total force on system is zero: Σ F_i = 0
#
# System: 3 dimers positioned at different x-coordinates in transition region
# This ensures pairs with different lambda values (lambda_i != lambda_j)
# Atom types: 1 = atomistic atom, 2 = CG particle
# Molecule IDs: 1, 2, 3

# ============================================================================
# Initialization
# ============================================================================

units           lj
atom_style      molecular
dimension       3
boundary        p p p

# ============================================================================
# Read system configuration
# ============================================================================

read_data       data.momentum_conservation

# Masses
mass            1 1.0   # Atomistic atoms
mass            2 2.0   # CG particles (mass = sum of 2 atoms)

# ============================================================================
# AdResS region definitions
# ============================================================================
# Define regions along x-axis with periodic wrapping:
# Layout: CG → Transition → Atomistic → Transition → CG (wrapping)
# CG region: 0.0-5.0 and 15.0-20.0 (edges, wraps around)
# Transition region: 5.0-7.5 and 12.5-15.0 (adjacent to CG, wraps around)
# Atomistic region: 7.5-12.5 (center)
# All dimers are in transition region (5.0-7.5) with different lambda values

# CG regions (left and right edges, wrapping around)
region          cg1 block 0.0 5.0 0.0 20.0 0.0 20.0
region          cg2 block 15.0 20.0 0.0 20.0 0.0 20.0
region          cg union 2 cg1 cg2

# Transition regions (adjacent to CG regions on both sides)
region          transition1 block 5.0 7.5 0.0 20.0 0.0 20.0
region          transition2 block 12.5 15.0 0.0 20.0 0.0 20.0
region          transition union 2 transition1 transition2

# Atomistic region (center, between transition regions)
region          atomistic block 7.5 12.5 0.0 20.0 0.0 20.0

# ============================================================================
# Pair interactions
# ============================================================================

# Simple LJ potential for both atomistic and CG
# Cutoff: 3.0
variable        cutoff equal 3.0

# AdResS pair style
pair_style      adress ${cutoff} lj/cut ${cutoff} lj/cut ${cutoff}

# Pair coefficients
# Atomistic: epsilon=1.0, sigma=1.0
# CG: epsilon=2.0, sigma=1.5 (stronger, larger)
pair_coeff      * * atomistic 1.0 1.0 ${cutoff} cg 2.0 1.5 ${cutoff} fix 1

# ============================================================================
# Neighbor settings
# ============================================================================

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# ============================================================================
# AdResS fixes
# ============================================================================

# Region management: calculate lambda values
fix             1 all adress/region atomistic transition cg x

# COM tracking and constraints (handles all three regions)
# Syntax: fix ID group-ID adress/constraint fix-region-ID cg-type
# Lambda thresholds: CG < 0.1, Transition: 0.1 <= lambda < 0.9, Atomistic >= 0.9
fix             2 all adress/constraint 1 2 lambda_cg 0.1 lambda_at 0.9

# ============================================================================
# Integration
# ============================================================================

timestep        0.005

# Velocity initialization - set non-zero velocities to test momentum conservation
# Give different velocities to different dimers to create non-zero total momentum
# Create groups for each dimer
group           dimer1 id 1 2 3
group           dimer2 id 4 5 6
group           dimer3 id 7 8 9

# Initialize velocities
velocity        all create 1.0 12345
# Add some additional velocity to create non-zero total momentum
velocity        dimer1 set 0.5 0.0 0.0 sum yes
velocity        dimer2 set -0.3 0.2 0.0 sum yes
velocity        dimer3 set 0.2 -0.1 0.1 sum yes

# NVE integration (momentum should be exactly conserved)
fix             3 all nve

# ============================================================================
# Output
# ============================================================================

# Compute for statistics
compute         adress_stats all adress/stats 1

# Thermo output (momentum will be calculated in verification script)
thermo_style    custom step temp pe ke etotal c_adress_stats[1] c_adress_stats[2] c_adress_stats[3]
thermo          10

# Dump trajectory with forces for direct verification of F_ij = -F_ji
# Include: id, type, mol, position (x,y,z), velocity (vx,vy,vz), force (fx,fy,fz)
dump            1 all custom 10 momentum_conservation.dump id type mol x y z vx vy vz fx fy fz

# ============================================================================
# Run
# ============================================================================

# Run for 500 steps (enough to see momentum conservation)
run             500

# ============================================================================
# Verification
# ============================================================================
# Automated verification:
#   python3 verify_momentum_conservation.py
#
# Manual verification:
#   - Check momentum_conservation.dump: total momentum should be constant
#   - Verify forces: F_ij = -F_ji for all pairs
#   - Check total force: Σ F_i ≈ 0

print "=========================================="
print "Phase 5 Momentum Conservation Verification Test"
print "=========================================="
print "Total atoms: $(atoms)"
print "Atomistic region atoms: $(c_adress_stats[1])"
print "Transition region atoms: $(c_adress_stats[2])"
print "CG region atoms: $(c_adress_stats[3])"
print ""
print "Verification:"
print "  1. Total momentum should be conserved: P(t) = P(0)"
print "  2. Forces should be symmetric: F_ij = -F_ji"
print "  3. Total force should be zero: Σ F_i = 0"
print ""
print "Automated verification:"
print "  python3 verify_momentum_conservation.py"
print ""
print "Manual verification:"
print "  - Check momentum_conservation.dump for momentum and force data"
print "  - Verify momentum conservation and force symmetry"
print "=========================================="
